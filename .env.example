# === VORA — Variables d'environnement (exemple) ===
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# NE JAMAIS committer le fichier .env rempli.

# --- Firebase ---
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# --- Cartographie ---
MAPS_API_KEY=

# --- Paiement (si applicable / simulé) ---
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_SECRET=

# --- IA (si utilisée pour une fonctionnalité d'innovation) ---
AI_API_KEY=

# --- Divers ---
APP_ENV=development
