rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Un utilisateur peut lire/modifier uniquement son propre profil.
    // Un admin peut tout lire.
    match /users/{userId} {
      allow read: if isOwner(userId) || role() == "admin";
      allow write: if isOwner(userId);
    }

    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isOwner(driverId) || role() == "admin";
    }

    // Une course n'est visible que par le passager, le chauffeur assigné, ou un admin.
    match /rides/{rideId} {
      allow read: if isSignedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        role() == "admin"
      );
      allow create: if isSignedIn() && request.resource.data.passengerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        role() == "admin"
      );
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn(); // à restreindre davantage avant la démo finale
      allow write: if false; // écritures uniquement via Cloud Functions
    }

    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
    }
  }
}
