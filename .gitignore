# Distribution archives (redundant with extracted source; keep the repo out of GitHub's size limits)
*.zip

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.iml

# ------------------------------------------------------------------
# Laravel backend (Code/Admin/Admin_Install)
# ------------------------------------------------------------------
**/Admin_Install/vendor/
**/Admin_Install/node_modules/
**/Admin_Install/.env
**/Admin_Install/.env.backup
**/Admin_Install/.phpunit.result.cache
**/Admin_Install/composer.phar
**/Admin_Install/tmp/
**/Admin_Install/bootstrap/cache/*.php
**/Admin_Install/storage/*.key
**/Admin_Install/storage/app/public/*
!**/Admin_Install/storage/app/public/.gitignore
**/Admin_Install/storage/framework/cache/data/*
**/Admin_Install/storage/framework/sessions/*
**/Admin_Install/storage/framework/views/*
**/Admin_Install/storage/framework/testing/*
**/Admin_Install/storage/logs/*.log
**/Admin_Install/storage/debugbar/
**/Admin_Install/storage/firebase/*.json
**/Admin_Install/public/storage
**/Admin_Install/public/hot
!**/Admin_Install/storage/**/.gitignore
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

